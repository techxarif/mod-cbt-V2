# ============================================================
# MODUS CBT — Root .htaccess
# ============================================================

# Prevent directory listing
Options -Indexes

# Custom Error Pages
ErrorDocument 404 /modus-cbt/404.php

# Block direct access to sensitive directories
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct access to includes/ folder
    RewriteRule ^includes/ - [F,L]

    # Block direct access to config/ folder
    RewriteRule ^config/ - [F,L]

    # Block direct access to storage/ folder
    RewriteRule ^storage/ - [F,L]

    # Block direct access to OLD CODE/ folder
    RewriteRule ^OLD\ CODE/ - [F,L]

    # Block access to .env file
    RewriteRule ^\.env - [F,L]
    RewriteRule ^\.env\..* - [F,L]
</IfModule>

# Block access to sensitive files
<FilesMatch "(\.env|composer\.lock|database\.sql|database_indexes\.sql)$">
    Require all denied
</FilesMatch>

# Security headers (supplement PHP headers)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
