DB_PASS=

; Application
APP_NAME=MODUS CBT
APP_URL=/modus-cbt/
APP_DEBUG=false

; Exam scoring constants
MARKS_CORRECT=4
MARKS_WRONG=1

; File uploads
UPLOAD_MAX_BYTES=5242880
